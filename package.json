{
  "name": "how",
  "version": "0.1.0",
  "private": true,
  "description": "Браузерные игры для Яндекс Игр",
  "type": "module",
  "scripts": {
    "dev": "vite games/steal",
    "build": "npm run typecheck && vite build games/steal",
    "preview": "vite preview games/steal",
    "artifact": "node tools/artifact.mjs",
    "package": "npm run build && node tools/package.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pacing": "vitest run games/steal/src/pacing.test.ts --silent=false",
    "art": "node tools/art/build.mjs"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
